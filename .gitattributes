# Files that belong in the repository but not in a release zip.
#
# `git archive` honours export-ignore, so ./deploy.sh --zip gets its exclusion
# list from here rather than from a list of rm commands someone has to remember.
# Anything untracked (vendor/, .git/) is absent from a git archive already.
/tests              export-ignore
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.eslintrc          export-ignore
/deploy.sh          export-ignore
/composer.json      export-ignore
